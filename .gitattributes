# Python's CSV writer emits standard CRLF records; preserve the raw evidence bytes.
*.csv -text whitespace=cr-at-eol
# Frozen protocols and their hashes must be byte-exact on every platform (hash verification).
PROTOCOL*.md -text
*.sha256 -text
RECORDS_SHA256.txt -text

# R21 hash-checked source fragments and plot inputs: preserve exact release bytes.
paper/r21/** -text
/README.md -text
/paper/README.md -text
/CHANGELOG.md -text
/CITATION.cff -text
paper/r21/**/*.pdf binary
paper/r21/**/*.zip binary

# R22 gates hash exact protocol, runner, configuration and provenance bytes.
research/r7c/r22/** -text
/research/r7c/methods.py -text
/research/r7c/ipix.py -text
/research/r7c/r15/netrad.py -text
paper/r22/** -text
research/r7c/study/results/r22_migration/summary/** -text
/research/r7c/study/results/r22_migration/EXECUTION_R22_M.json -text
research/r7c/r22/**/*.pdf binary
research/r7c/r22/**/*.png binary
paper/r22/**/*.pdf binary
paper/r22/**/*.zip binary
